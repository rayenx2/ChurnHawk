# ============================================================
# ChurnHawk Environment Configuration
# Copy this file to .env and adjust values as needed.
# All defaults below work out-of-the-box with `docker compose up`.
# ============================================================

# ------------------------------
# Application
# ------------------------------
APP_NAME=ChurnHawk
APP_VERSION=1.0.0
DEBUG=False
LOG_LEVEL=INFO

# ------------------------------
# PostgreSQL (used by Airflow & MLflow backend store)
# ------------------------------
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ------------------------------
# MinIO (S3-compatible object storage — replaces AWS S3)
# Used by MLflow for artifact storage and by DVC for data versioning
# ------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=dvc-storage
MINIO_SECURE=False

# ------------------------------
# MLflow Experiment Tracking & Model Registry
# ------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=churn_prediction
MLFLOW_ARTIFACT_LOCATION=s3://mlflow/

# S3 connection used by MLflow/DVC (points at the MinIO container)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000

# ------------------------------
# Apache Airflow
# ------------------------------
# Required on Linux/WSL to avoid volume permission issues
AIRFLOW_UID=1000

# ------------------------------
# Model Configuration
# ------------------------------
MODEL_NAME=xgboost_churn_classifier
MODEL_STAGE=Production
MODEL_PATH=models/
RANDOM_STATE=42

# ------------------------------
# Training Configuration
# ------------------------------
TRAIN_TEST_SPLIT=0.2
CV_FOLDS=5

# ------------------------------
# XGBoost Hyperparameters
# ------------------------------
XGBOOST_MAX_DEPTH=6
XGBOOST_LEARNING_RATE=0.1
XGBOOST_N_ESTIMATORS=100
XGBOOST_MIN_CHILD_WEIGHT=1
XGBOOST_SUBSAMPLE=0.8
XGBOOST_COLSAMPLE_BYTREE=0.8

# ------------------------------
# Data Paths
# ------------------------------
DATA_RAW_PATH=data/raw/
DATA_PROCESSED_PATH=data/processed/
DATA_REPORTS_PATH=data/reports/

# ------------------------------
# Inference API
# ------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# ------------------------------
# Monitoring (Prometheus / Grafana)
# ------------------------------
ENABLE_PROMETHEUS=True
PROMETHEUS_PORT=9090
